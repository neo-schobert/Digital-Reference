# --- Chatbot (OpenRouter) -------------------------------------------
# Get a key at https://openrouter.ai/keys and paste it below.
# This file is an example: real values go in analysis/.env (git-ignored).
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE

# Optional overrides (defaults shown) ---------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Question router (fast & cheap classification)
# CHAT_MODEL_ROUTER=google/gemini-2.5-flash-lite
# SPARQL generation (strong reasoning model)
# CHAT_MODEL_SPARQL=anthropic/claude-sonnet-5
# Final grounded answer
# CHAT_MODEL_ANSWER=anthropic/claude-sonnet-5
# Concept-card embeddings (computed once, cached in analysis/.cache/)
# CHAT_EMBEDDING_MODEL=openai/text-embedding-3-small
